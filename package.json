{
  "name": "vrchat-asset-library",
  "version": "1.4.1-preview.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/NecoAya/VRCAL-VRChat-Asset-Library.git"
  },
  "bugs": {
    "url": "https://github.com/NecoAya/VRCAL-VRChat-Asset-Library/issues"
  },
  "homepage": "https://github.com/NecoAya/VRCAL-VRChat-Asset-Library#readme",
  "description": "本地 VRChat 素材库",
  "author": "Local Library",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.main.json && node --test --test-concurrency=1 tests/*.test.cjs",
    "package": "npm run build && install-electron && electron-builder --win portable --x64 --publish never && node scripts/verify-package.cjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.vrchat.assetlibrary",
    "productName": "VRC素材库",
    "directories": {
      "output": "../build-stage"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "assets/library.png",
      "assets/unity/**/*",
      "assets/preview.html",
      "assets/booth-workspace.html",
      "assets/window-themes.css",
      "assets/fonts/**/*",
      "package.json",
      "LICENSE",
      "licenses/**/*",
      "docs/LICENSING.md",
      "docs/USER_AGREEMENT.zh-CN.md",
      "docs/PRIVACY.zh-CN.md",
      "docs/PUBLIC_PLUGINS.zh-CN.md",
      "docs/PUBLIC_PLUGIN_SOURCES_20261024.json",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "assets/local-i18n.js",
      "assets/update-helper.ps1",
      "assets/update-launcher.ps1",
      "assets/baidu-workspace.html",
      "assets/xianyu.html",
      "assets/xianyu.css",
      "docs/LOCAL_PREVIEW_20261024.zh-CN.md",
      "docs/AI_BACKEND.md",
      "docs/LINK_INBOX_READERS.zh-CN.md",
      "docs/AI_DISCOVERY.zh-CN.md",
      "docs/AVATAR_WORKFLOW_REPORT.zh-CN.md",
      "docs/AVATAR_WORKBENCH.zh-CN.md",
      "docs/screenshots/workbench/**/*",
      "docs/WORKSPACE_NAVIGATION.zh-CN.md",
      "docs/screenshots/navigation/**/*",
      "docs/RELEASE_1.4.0-preview.5.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.6.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.7.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.9.zh-CN.md",
      "docs/XIANYU_CONNECTION_CHECK.zh-CN.md",
      "docs/MODEL_PREVIEW.zh-CN.md",
      "docs/screenshots/model-preview/**/*",
      "docs/MODEL_PREVIEW.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.9.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.10.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.10.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.11.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.11.zh-CN.html",
      "docs/SCANNING_AND_COVERS.zh-CN.md",
      "docs/SCANNING_AND_COVERS.zh-CN.html",
      "docs/LINK_INBOX_READERS.zh-CN.html",
      "docs/PRIVACY.zh-CN.html",
      "docs/USER_AGREEMENT.zh-CN.html",
      "docs/WORK_PLAN_20261024.zh-CN.md",
      "docs/WORK_PLAN_20261024.zh-CN.html",
      "docs/AVATAR_WORKFLOW_REPORT.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.12.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.12.zh-CN.html",
      "docs/AI_DISCOVERY.zh-CN.html",
      "docs/screenshots/web-ai/**/*",
      "docs/PERFORMANCE.zh-CN.md",
      "docs/PERFORMANCE.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.13.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.13.zh-CN.html",
      "docs/DOWNLOADS.zh-CN.md",
      "docs/DOWNLOADS.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.14.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.14.zh-CN.html",
      "docs/images/download-selection-preview14.png",
      "docs/RELEASE_1.4.0-preview.15.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.15.zh-CN.html",
      "docs/AVATAR_WORKBENCH.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.16.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.16.zh-CN.html",
      "docs/MA_MENU_PREVIEW_DIAGNOSTICS.zh-CN.md",
      "docs/MA_MENU_PREVIEW_DIAGNOSTICS.zh-CN.html",
      "docs/images/download-extraction-result-preview16.png",
      "docs/images/download-extraction-options-preview16.png",
      "docs/RELEASE_1.4.1-preview.1.zh-CN.md",
      "docs/RELEASE_1.4.1-preview.1.zh-CN.html",
      "docs/RELEASE_1.4.0.zh-CN.md",
      "docs/RELEASE_1.4.0.zh-CN.html",
      "docs/RELEASE_1.4.0-preview.17.zh-CN.md",
      "docs/RELEASE_1.4.0-preview.17.zh-CN.html",
      "docs/SOURCE_LOCATIONS.zh-CN.md",
      "docs/SOURCE_LOCATIONS.zh-CN.html",
      "docs/images/source-locations-selection-preview17.png",
      "docs/RELEASE_1.4.0.en.md",
      "docs/RELEASE_1.4.0.ja.md",
      "docs/QUICK_START.en.md",
      "docs/QUICK_START.ja.md",
      "docs/USER_GUIDE.md"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/library.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "VRC-Asset-Library-${version}-x64.exe",
      "requestExecutionLevel": "user"
    }
  }
}
